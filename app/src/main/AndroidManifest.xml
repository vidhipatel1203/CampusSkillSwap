        <activity
            android:name=".MainActivity"
            android:exported="false" />

        <activity
            android:name=".ExploreActivity"
            android:exported="false" />

        <activity
            android:name=".SkillDetailsActivity"
            android:exported="false" />

        <activity
            android:name=".SwapRequestActivity"
            android:exported="false" />

        <activity
            android:name=".RequestsActivity"
